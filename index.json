{
  "version": "1.0.0",
  "name": "mvgeos-marketplace",
  "description": "Official extension marketplace for MvgeOS runes",
  "runes": {
    "openrouter-realm": {
      "name": "openrouter-realm",
      "version": "0.1.0",
      "description": "Official OpenRouter provider realm for MvgeOS",
      "types": [
        "RealmProvider"
      ],
      "runtime": "python",
      "git": "https://github.com/IAmNo1Special/mvgeos-marketplace.git",
      "path": "runes/openrouter-realm",
      "hooks": [
        "before_provider_request",
        "after_provider_response"
      ],
      "python_deps": [
        "httpx>=0.27"
      ]
    },
    "heal-my-goap": {
      "name": "heal-my-goap",
      "version": "0.1.0",
      "description": "Zero-token GOAP planning & LLM-powered self-healing Rune for MvgeOS",
      "types": [
        "Planner",
        "Spell Modifier"
      ],
      "runtime": "python",
      "git": "https://github.com/IAmNo1Special/mvgeos-marketplace.git",
      "path": "runes/heal-my-goap",
      "hooks": [
        "session_start",
        "after_spell_result"
      ],
      "python_deps": [
        "heal_my_goap"
      ]
    },
    "seeker": {
      "name": "seeker",
      "version": "0.1.0",
      "description": "Seeker Protocol - DCI-based discovery for spells, skills, and MCP servers",
      "types": [
        "Spell",
        "Spell Modifier"
      ],
      "runtime": "python",
      "git": "https://github.com/IAmNo1Special/mvgeos-marketplace.git",
      "path": "runes/seeker",
      "hooks": [
        "before_mvge_start",
        "session_shutdown"
      ],
      "python_deps": [
        "aiohttp"
      ]
    }
  }
}
