{
  "name": "heal-my-goap",
  "version": "0.1.0",
  "description": "Zero-token GOAP planning & LLM-powered self-healing Rune for MvgeOS",
  "types": [
    "Planner",
    "Spell Modifier"
  ],
  "entry_point": "rune.py",
  "hooks": [
    "session_start",
    "before_invocation",
    "after_spell_result"
  ],
  "python_deps": [
    "goapauto @ git+https://github.com/IAmNo1Special/goapauto@main",
    "httpx>=0.28.1",
    "pydantic>=2.13.4",
    "psutil>=6.0.0",
    "python-dotenv>=1.2.2"
  ],
  "enabled": true
}
